---

type Props = {
  educations: {
    name: string;
    title: string;
    startDate: string;
    endDate: string;
  }[];
  languages: {
    name: string;
    level: string;
  }[];
};

const { educations, languages } = Astro.props;
---

<section class="section credentials-section" aria-labelledby="credentials-heading">
  <div class="section-heading">
    <h2 id="credentials-heading">Education and languages</h2>
    <span class="section-rule" aria-hidden="true"></span>
  </div>
  {educations.map((education) => (
    <p><strong>{education.title}</strong>, {education.name}, {education.startDate} - {education.endDate}.</p>
  ))}
  <p>{languages.map((language) => `${language.name}: ${language.level}`).join('. ')}.</p>
</section>
