---
import Education from './Education.astro';
import Language from './Language.astro';

type Props = {
  educations: {
    name: string;
    title: string;
    startDate: string;
    endDate: string;
  }[];
  languages: {
    name: string;
    level: string;
  }[];
};

const { educations, languages } = Astro.props;
---

<section class="section details-section" aria-label="Education and languages">
  <div class="details-column">
    <div class="section-heading">
      <h2>Education</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    {educations.map((education) => <Education {...education} />)}
  </div>

  <div class="details-column">
    <div class="section-heading">
      <h2>Languages</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>
    <ul class="language-list">
      {languages.map((language) => <Language {...language} />)}
    </ul>
  </div>
</section>
