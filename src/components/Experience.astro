---
type Props = {
  companyName: string;
  companyUrl: string;
  companyContext?: string;
  positionTitle: string;
  previousTitle?: string;
  startDate: string;
  endDate: string;
  description: {
    summary: string;
    highlights: string[];
    skills: string[];
  };
};

const {
  companyName,
  companyUrl,
  companyContext,
  positionTitle,
  previousTitle,
  startDate,
  endDate,
  description,
} = Astro.props;
---

<article class="experience-entry">
  <div class="experience-content">
    <div class="experience-heading">
      <h3>{positionTitle}</h3>
      <p class="experience-dates">{startDate} - {endDate}</p>
    </div>
    {previousTitle && <p class="previous-title">{previousTitle}</p>}
    <p class="experience-company-link">
      <a href={companyUrl} target="_blank" rel="noreferrer">{companyName}</a>
    </p>
    {companyContext && <p class="company-context">{companyContext}</p>}
    <p class="experience-summary">{description.summary}</p>

    {description.highlights.length > 0 && (
      <ul class="experience-highlights">
        {description.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    )}

    {description.skills.length > 0 && (
      <div class="experience-skills">
        <span class="skills-label">Tools</span>
        <ul class="skill-list skill-list-compact">
          {description.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    )}
  </div>
</article>
