---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import Educations from '../components/Educations.astro';
import WorkExperience from '../components/WorkExperience.astro';
import '../styles.css';

type Experience = {
  companyName: string;
  companyUrl: string;
  companyContext?: string;
  positionTitle: string;
  previousTitle?: string;
  startDate: string;
  endDate: string;
  description: {
    summary: string;
    highlights: string[];
    skills: string[];
  };
};

type Props = {
  frontmatter: {
    title: string;
    pdfLink?: string;
    noIndex?: boolean;
    description?: string;
    headline: string;
    specialism: string;
    location: string;
    workAuthorisation?: string;
    email: string;
    linkedin: string;
    website?: string;
    coreSkills: string[];
    positions: Experience[];
    earlierExperience: {
      companyName: string;
      dates: string;
      title: string;
      summary: string;
    }[];
    projects: { name: string; url?: string; summary: string }[];
    educations: {
      name: string;
      title: string;
      startDate: string;
      endDate: string;
    }[];
    languages: {
      name: string;
      level: string;
    }[];
  };
};

const { frontmatter } = Astro.props;
const {
  title,
  pdfLink,
  noIndex,
  description,
  headline,
  specialism,
  location,
  workAuthorisation,
  email,
  linkedin,
  website,
  coreSkills,
  positions,
  earlierExperience,
  projects,
  educations,
  languages,
} = frontmatter;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || title} />
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{title} | CV</title>
  </head>
  <body>
    <main class="resume-shell">
      <article class="resume" aria-labelledby="profile-name">
        <header class="profile">
          <div class="profile-masthead">
            <div class="profile-topline">
              <span class="eyebrow">Trading, payments &amp; developer platforms</span>
              <span>{location}</span>
            </div>

            <div class="profile-header">
              <div class="profile-identity">
                <h1 id="profile-name">{title}</h1>
                <p class="profile-kicker">{headline}</p>
                <p class="profile-specialism">{specialism}</p>
              </div>

              <div class="profile-photo">
                <img src="/ProfilePicture.png" alt="Portrait of Serkan Gunes" width="120" height="120" />
              </div>
            </div>

            <div class="profile-contact">
              <ul class="contact-list" aria-label="Contact details">
                <li><a href={`mailto:${email}`}>{email}</a></li>
                <li><a href={linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
                {website && <li><a href={website} target="_blank" rel="noreferrer">Website</a></li>}
                {workAuthorisation && <li>{workAuthorisation}</li>}
              </ul>
              {pdfLink && (
                <a class="download-link" href={`/${pdfLink}`} download>
                  Download CV
                </a>
              )}
            </div>
          </div>

          <section class="summary" aria-labelledby="summary-heading">
            <p class="section-label" id="summary-heading">Profile</p>
            <div class="summary-copy"><slot /></div>
          </section>
        </header>

        <div class="resume-content">
          <section class="section core-skills" aria-labelledby="skills-heading">
            <div class="section-heading">
              <h2 id="skills-heading">Core skills</h2>
              <span class="section-rule" aria-hidden="true"></span>
            </div>
            <ul class="skill-list">
              {coreSkills.map((skill) => <li>{skill}</li>)}
            </ul>
          </section>

          <WorkExperience positions={positions} />

          <section class="section earlier-experience" aria-labelledby="earlier-heading">
            <div class="section-heading">
              <h2 id="earlier-heading">Earlier experience</h2>
              <span class="section-rule" aria-hidden="true"></span>
            </div>
            {earlierExperience.map((role) => (
              <article class="compact-entry">
                <h3>{role.companyName} <span>{role.dates}</span></h3>
                <p><span class="compact-title">{role.title}.</span> {role.summary}</p>
              </article>
            ))}
          </section>

          <section class="section independent-projects" aria-labelledby="projects-heading">
            <div class="section-heading">
              <h2 id="projects-heading">Selected independent projects</h2>
              <span class="section-rule" aria-hidden="true"></span>
            </div>
            <ul class="project-list">
              {projects.map((project) => (
                <li><strong>{project.name}.</strong> {project.url && <><a href={project.url}>{new URL(project.url).hostname}</a>. </>}{project.summary}</li>
              ))}
            </ul>
          </section>
          <Educations educations={educations} languages={languages} />
        </div>
      </article>
    </main>
  </body>
</html>
