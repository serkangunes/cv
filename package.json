{
  "name": "astro-resume",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate-pdf": "tsx ./scripts/generate-pdf.ts",
    "generate-pdf:ci": "start-server-and-test \"ASTRO_DEV_BACKGROUND=false npm run dev -- --host 127.0.0.1 --port 4321\" 4321 generate-pdf",
    "build": "astro check && npm run generate-pdf:ci && astro build",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^26.5.0",
    "astro": "^7.3.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
